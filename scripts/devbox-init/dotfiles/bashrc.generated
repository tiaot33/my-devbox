# ~/.bashrc.generated - 由 scripts/devbox-init 生成
# 请不要手改此文件；重新运行 mise bootstrap 会覆盖。
# 个人自定义请放到 ~/.config/shell/local.sh。

[[ $- != *i* ]] && return

# ── 环境变量 ─────────────────────────────────────────────────────────────────

export LANG=${LANG:-en_US.UTF-8}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
if [[ -z ${TERM:-} || ${TERM:-} == dumb ]]; then
  export TERM=xterm-256color
fi
PATH="$HOME/.local/bin:$PATH"
# 部分 coding agent 官方安装器不用 ~/.local/bin；mise 装的走 activate
[ -d "$HOME/.grok/bin" ] && PATH="$PATH:$HOME/.grok/bin"
[ -d "$HOME/.opencode/bin" ] && PATH="$PATH:$HOME/.opencode/bin"
[ -d "$HOME/.kimi-code/bin" ] && PATH="$PATH:$HOME/.kimi-code/bin"
export PATH

# 必须在 command -v fzf/direnv/zoxide 等之前：mise bootstrap 会把
# source ~/.bashrc.generated 写在 ~/.bashrc 的 activate 块前面。
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
else
  export EDITOR=vim
fi
export VISUAL="$EDITOR"
export PAGER=less
if less --help 2>&1 | grep -q -- '--mouse'; then
  export LESS='-R -F -X -i -M --mouse --wheel-lines=3'
else
  export LESS='-R -F -X -i -M'
fi
export BAT_PAGER=less
if command -v bat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
else
  export MANPAGER='less -R'
fi

# ── Shell 行为 ───────────────────────────────────────────────────────────────

export HISTSIZE=200000
export HISTFILESIZE=400000
export HISTCONTROL=ignoreboth:erasedups
export HISTTIMEFORMAT='%F %T  '
export HISTIGNORE='ls:ll:la:lt:l:history:exit:clear:bg:fg:cd:z:atuin'
shopt -s histappend cmdhist checkwinsize globstar autocd dirspell 2>/dev/null || true
stty -ixon 2>/dev/null || true
bind 'set bell-style none' 2>/dev/null || true

# ── 补全 ─────────────────────────────────────────────────────────────────────
# 顺序：bash-completion → fzf → ble.sh → carapace → mise。
# carapace 必须在 fzf 之后，否则 fzf 会把 git/systemctl 等改成路径补全。
# carapace 必须在 ble.sh 之后，才能用 bash-ble 桥，避免 ble 劫持 read。

if [ -f /etc/bash_completion ]; then
  source /etc/bash_completion
fi

if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash 2>/dev/null)" || true
fi
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git 2>/dev/null'
else
  export FZF_DEFAULT_COMMAND='find . -type f 2>/dev/null'
fi
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# ── 工具集成 (加载顺序很重要) ─────────────────────────────────────────────────

# ble.sh — 必须在 carapace / atuin 之前加载
if [[ -s "$HOME/.local/share/blesh/ble.sh" ]]; then
  source -- "$HOME/.local/share/blesh/ble.sh" --attach=none
fi

# carapace 接管已注册 CLI 的参数补全；只桥接 bash。
# 不要用 `carapace _carapace` 自动探测：ble 尚未 attach 时会选错脚本。
# 原脚本的 `IFS=$'\001' read -r -d '' nospace data` 在 bash 5.3 / ble.sh
# 包装 read 时会报: read: `    ': not a valid identifier
_devbox_carapace_completer() {
  export COMP_LINE COMP_POINT COMP_TYPE COMP_WORDBREAKS
  declare -x CARAPACE_SHELL=bash
  declare -x CARAPACE_SHELL_ALIASES="$(compgen -a)"
  declare -x CARAPACE_SHELL_BUILTINS="$(compgen -b)"
  declare -x CARAPACE_SHELL_FUNCTIONS="$(compgen -A function)"
  declare -x CARAPACE_SHELL_JOBS="$(jobs 2>/dev/null | while builtin read -r line; do
    [[ $line =~ \[([0-9]+)\] ]] && echo "%${BASH_REMATCH[1]}"
  done)"
  declare -x CARAPACE_SHELL_VARIABLES="$(compgen -v)"

  local command="${COMP_WORDS[0]}" nospace data compline="${COMP_LINE:0:${COMP_POINT}}"

  data=$(printf '%s\n' "${compline}''" | xargs carapace "${command}" bash 2>/dev/null)
  if [ $? -eq 1 ]; then
    data=$(printf '%s\n' "${compline}'" | xargs carapace "${command}" bash 2>/dev/null)
    if [ $? -eq 1 ]; then
      data=$(printf '%s\n' "${compline}\"" | xargs carapace "${command}" bash 2>/dev/null)
    fi
  fi

  if [[ $data == *$'\001'* ]]; then
    nospace=${data%%$'\001'*}
    data=${data#*$'\001'}
  else
    nospace=
  fi
  mapfile -t COMPREPLY < <(printf '%s\n' "${data}")
  unset COMPREPLY[-1]
  [ "${nospace}" = true ] && compopt -o nospace
  local IFS=$'\n'
  [[ "${COMPREPLY[*]}" == "" ]] && COMPREPLY=()
}

if command -v carapace >/dev/null 2>&1; then
  export CARAPACE_BRIDGES=bash
  if [[ ${BLE_VERSION-} ]]; then
    source <(carapace _carapace bash-ble)
  else
    source <(carapace _carapace bash)
  fi
  eval "$(declare -f _devbox_carapace_completer | sed '1s/_devbox_carapace_completer/_carapace_completer/')"
fi

# carapace 没有 mise 补全器；usage 已由 mise 安装。
if command -v mise >/dev/null 2>&1; then
  eval "$(mise completion bash 2>/dev/null)" || true
fi

# direnv
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi

# zoxide — 智能 cd
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
  alias cd='z'
fi

# try — 给每次实验一个带日期的目录（https://github.com/tobi/try）
# 必须是 shell 函数才能 cd；默认目录 ~/src/tries，可用 TRY_PATH 改。
if command -v try >/dev/null 2>&1; then
  eval "$(try init)"
fi

# Atuin — shell 历史搜索
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init bash --disable-up-arrow)"
fi

# Starship — 命令行提示符 (必须最后加载)
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# ── 别名 & 实用函数 ─────────────────────────────────────────────────────────

[ -f "$HOME/.config/shell/aliases.sh" ]   && source "$HOME/.config/shell/aliases.sh"
[ -f "$HOME/.config/shell/functions.sh" ] && source "$HOME/.config/shell/functions.sh"
[ -f "$HOME/.config/shell/local.sh" ]     && source "$HOME/.config/shell/local.sh"

# ── SSH 登录 ─────────────────────────────────────────────────────────────────

if [[ -n ${SSH_CONNECTION-} ]]; then
  if command -v fastfetch >/dev/null 2>&1; then
    fastfetch
  fi
fi

# ble.sh — 在所有交互式设置之后附加
[[ ! ${BLE_VERSION-} ]] || ble-attach
